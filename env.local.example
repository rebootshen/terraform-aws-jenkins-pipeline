# Copy to env.local and fill in. env.local is gitignored.
# Terraform and Jenkins read these from the environment or from the Jenkins credential store.
# This repository does not contain real AWS keys.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Remote state backend used by backend.tf
TF_STATE_BUCKET=jenkins-bucket-samshen
TF_STATE_KEY=remote.tfstate
TF_STATE_REGION=us-east-1
